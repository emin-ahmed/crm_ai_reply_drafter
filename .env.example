# crm_ai_reply_assistant — example environment variables
#
# These are OPTIONAL fallbacks. The module reads its provider, model, system
# prompt and API key from Settings → CRM (stored as ir.config_parameter), and
# Settings always take precedence. Use these env vars only for local dev or CI
# when you would rather not type a key into the database.
#
# NEVER commit a real key. Copy this file to `.env` (gitignored) and fill it in.

# Which provider the service falls back to if none is configured in Settings.
# One of: openai | anthropic | ollama
CRM_AI_REPLY_PROVIDER=anthropic

# --- Anthropic ---------------------------------------------------------------
# Get a key at https://console.anthropic.com/ . Default model is claude-opus-4-8.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CRM_AI_REPLY_ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CRM_AI_REPLY_OPENAI_MODEL=gpt-4o
# Optional: point the OpenAI provider at an OpenAI-compatible gateway. Leave
# empty for OpenAI itself. For OpenRouter, set the base URL below, use your
# OpenRouter key as OPENAI_API_KEY, and a provider-prefixed model id
# (e.g. anthropic/claude-sonnet-4, openai/gpt-4o).
CRM_AI_REPLY_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Ollama (local, no key needed) -------------------------------------------
# Point at your running Ollama server. No API key required for local use.
CRM_AI_REPLY_OLLAMA_BASE_URL=http://localhost:11434
CRM_AI_REPLY_OLLAMA_MODEL=llama3.1
